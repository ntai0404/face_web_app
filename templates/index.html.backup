<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Face Attendance System v2.0</title>
    <link rel="stylesheet" href="/static/css/style.css">
</head>

<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <h1>🎯 Face Attendance System</h1>
            <p class="subtitle">Hệ thống điểm danh khuôn mặt với AI</p>
        </header>

        <!-- Tab Navigation -->
        <nav class="tabs">
            <button class="tab-btn active" data-tab="checkin">
                <span class="icon">✅</span> Check-in
            </button>
            <button class="tab-btn" data-tab="register">
                <span class="icon">👤</span> Đăng ký
            </button>
            <button class="tab-btn" data-tab="logs">
                <span class="icon">📊</span> Logs
            </button>
        </nav>

        <!-- Tab Contents -->
        <main class="tab-content">
            <!-- Tab 1: Check-in -->
            <div id="checkin-tab" class="tab-pane active">
                <h2>📸 Check-in nhân viên</h2>
                <p class="instruction">Đứng trước camera để hệ thống tự động nhận diện khuôn mặt</p>

                <div class="camera-section">
                    <div class="video-container">
                        <video id="checkin-video" autoplay playsinline></video>
                        <canvas id="checkin-canvas" style="display: none;"></canvas>

                        <!-- Scanning overlay -->
                        <div id="scanning-overlay" class="scanning-overlay" style="display: none;">
                            <div class="scan-line"></div>
                            <p class="scan-text">🔍 Đang quét khuôn mặt...</p>
                        </div>
                    </div>

                    <div class="camera-controls">
                        <button id="start-checkin-camera" class="btn btn-primary btn-large">
                            🎥 Bắt đầu Check-in
                        </button>
                        <button id="stop-checkin-camera" class="btn btn-secondary" style="display: none;">
                            ⏸️ Dừng
                        </button>
                    </div>

                    <div id="checkin-status" class="status-text" style="display: none;">
                        <span class="status-icon">⏳</span>
                        <span class="status-message">Sẵn sàng nhận diện...</span>
                    </div>
                </div>

                <div id="checkin-result" class="result-box" style="display: none;">
                    <h3>Kết quả Check-in</h3>
                    <div id="checkin-info"></div>
                </div>
            </div>

            <!-- Tab 2: Register -->
            <div id="register-tab" class="tab-pane">
                <h2>👤 Đăng ký nhân viên mới</h2>

                <form id="register-form" class="register-form">
                    <div class="form-group">
                        <label for="employee-code">Mã nhân viên:</label>
                        <input type="text" id="employee-code" required placeholder="VD: NV001">
                    </div>

                    <div class="form-group">
                        <label for="full-name">Họ và tên:</label>
                        <input type="text" id="full-name" required placeholder="VD: Nguyễn Văn A">
                    </div>

                    <div class="form-group">
                        <label for="department">Phòng ban:</label>
                        <input type="text" id="department" placeholder="VD: IT Department">
                    </div>
                </form>

                <div class="camera-section">
                    <video id="register-video" autoplay playsinline></video>
                    <canvas id="register-canvas" style="display: none;"></canvas>

                    <div class="camera-controls">
                        <button id="start-register-camera" class="btn btn-primary">
                            🎥 Bật Camera
                        </button>
                        <button id="capture-photo" class="btn btn-info" disabled>
                            📸 Chụp ảnh (<span id="photo-count">0</span>/10)
                        </button>
                    </div>
                </div>

                <div id="photos-preview" class="photos-grid"></div>

                <button id="submit-register" class="btn btn-success btn-large" disabled>
                    ✅ Đăng ký & Train Model
                </button>

                <div id="register-result" class="result-box" style="display: none;">
                    <div id="register-info"></div>
                </div>
            </div>

            <!-- Tab 3: Logs -->
            <div id="logs-tab" class="tab-pane">
                <h2>📊 Lịch sử Check-in</h2>

                <div class="logs-section">
                    <div class="logs-header">
                        <button id="refresh-logs" class="btn btn-primary">
                            🔄 Tải lại dữ liệu
                        </button>
                        <button id="export-excel" class="btn btn-success">
                            📥 Xuất Excel
                        </button>
                        <div class="logs-stats">
                            <span class="stat-item">
                                <strong>Tổng:</strong> <span id="total-logs">0</span> lượt
                            </span>
                            <span class="stat-item">
                                <strong>Hôm nay:</strong> <span id="today-logs">0</span> lượt
                            </span>
                        </div>
                    </div>

                    <div class="table-container">
                        <table id="logs-table" class="logs-table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Thời gian</th>
                                    <th>Mã NV</th>
                                    <th>Họ tên</th>
                                    <th>Độ tin cậy</th>
                                    <th>Liveness</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody id="logs-tbody">
                                <tr>
                                    <td colspan="7" class="no-data">
                                        <div class="loading">
                                            <span>📊</span>
                                            <p>Nhấn "Tải lại dữ liệu" để xem lịch sử check-in</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="logs-footer">
                        <p class="note">💡 <strong>Lưu ý:</strong> Dữ liệu được lưu trên Google Sheets. Bạn có thể xuất
                            Excel để phân tích offline.</p>
                        <a href="https://docs.google.com/spreadsheets/d/1xDNraddeqoSO57_meskZZmfneEsPPZrdSoHVBJy_RLY/edit"
                            target="_blank" class="sheet-link">
                            📄 Xem Google Sheet (Admin only)
                        </a>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <p>Face Attendance System v2.0 | Powered by FastAPI + MediaPipe + SVM</p>
        </footer>
    </div>

    <!-- MediaPipe CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_detection/face_detection.js"
        crossorigin="anonymous"></script>

    <!-- App Scripts -->
    <script src="/static/js/mediapipe-detection.js"></script>
    <script src="/static/js/check-in.js"></script>
    <script src="/static/js/register.js"></script>
    <script src="/static/js/logs.js"></script>
    <script src="/static/js/main.js"></script>
</body>

</html>